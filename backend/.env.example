# Salin menjadi .env lalu sesuaikan. JANGAN commit file .env.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://learnova:learnova@localhost:5432/learnova
TEST_DATABASE_URL=postgresql+psycopg://learnova:learnova@localhost:5432/learnova_test
# Produksi: string acak minimal 32 karakter, mis. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRES_MINUTES=720
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Hanya dibaca image produksi (start.sh)
PORT=8000
SEED_DEMO=false
